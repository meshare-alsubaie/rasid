{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rasid.local/schemas/health.schema.json",
  "title": "RASID source health file",
  "description": "Drives the honesty layer. Surfaced in the UI, never hidden in logs.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceUrl",
      "orgId",
      "lastAttemptISO",
      "lastSuccessISO",
      "consecutiveFailures",
      "lastError",
      "state"
    ],
    "properties": {
      "sourceUrl": { "type": "string", "format": "uri" },
      "orgId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
      "lastAttemptISO": { "type": "string", "format": "date-time" },
      "lastSuccessISO": { "type": ["string", "null"], "format": "date-time" },
      "consecutiveFailures": { "type": "integer", "minimum": 0 },
      "lastError": { "type": ["string", "null"] },
      "state": { "type": "string", "enum": ["healthy", "degraded", "broken"] }
    }
  }
}
